# 独立网盘配置。未设置 DRIVE_TURSO_* / DRIVE_COS_* 时，可兼容读取工作区已有的 TURSO_* / COS_*。
DRIVE_USERNAME=owner
DRIVE_PASSWORD=
DRIVE_PASSWORD_HASH=
DRIVE_SESSION_SECRET=

DRIVE_TURSO_DATABASE_URL=
DRIVE_TURSO_AUTH_TOKEN=

DRIVE_COS_SECRET_ID=
DRIVE_COS_SECRET_KEY=
DRIVE_COS_BUCKET=
DRIVE_COS_REGION=ap-bangkok
DRIVE_COS_PREFIX=tow1/files/

NEXT_PUBLIC_APP_URL=https://tow1.zhuoline.cn
NEXT_PUBLIC_MAX_UPLOAD_MB=5120
NEXT_PUBLIC_STORAGE_QUOTA_GB=50
DRIVE_MAX_ZIP_MB=100
